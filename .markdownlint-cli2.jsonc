{
  "config": {
    // Prettier owns wrapping, emphasis, list markers, and table alignment.
    "MD013": false,
    "MD004": false,
    "MD049": false,
    "MD060": false,
    // Release notes repeat Added/Changed under distinct version headings.
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["img", "p", "br", "details", "summary"] },
  },
}
